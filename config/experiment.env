# Source this file from Bash. Every value can also be overridden in the
# environment, or by pointing CONFIG_FILE at another file.

EXPERIMENT_NAME="${EXPERIMENT_NAME:-cloud-serving-benchmark-llama32-1b-q4km}"

# Accelerator backend: auto, rocm, or cuda. Auto detects an installed toolkit.
# If both toolkits are installed, select one explicitly.
ACCELERATOR_BACKEND="${ACCELERATOR_BACKEND:-auto}"

# llama.cpp build. master is resolved to a concrete commit and recorded with
# every result. Set LLAMA_CPP_REF to a commit hash for a permanently pinned run.
LLAMA_CPP_REPO="${LLAMA_CPP_REPO:-https://github.com/ggml-org/llama.cpp.git}"
LLAMA_CPP_REF="${LLAMA_CPP_REF:-master}"
ROCM_GPU_TARGETS="${ROCM_GPU_TARGETS:-gfx942}"
# Leave empty to let CMake compile for the locally detected NVIDIA GPU. For a
# portable binary, set a semicolon-separated list such as "80;90".
CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES:-}"
BUILD_JOBS="${BUILD_JOBS:-16}"

# Small starter model. Replace these three values together when adding another
# quantization format.
MODEL_URL="${MODEL_URL:-https://huggingface.co/bartowski/Llama-3.2-1B-Instruct-GGUF/resolve/main/Llama-3.2-1B-Instruct-Q4_K_M.gguf}"
MODEL_FILENAME="${MODEL_FILENAME:-Llama-3.2-1B-Instruct-Q4_K_M.gguf}"
MODEL_ALIAS="${MODEL_ALIAS:-llama-3.2-1b-instruct-q4-k-m}"

# One GPU. Keep these server settings fixed across quantization variants.
GPU_DEVICE="${GPU_DEVICE:-0}"
SERVER_HOST="${SERVER_HOST:-127.0.0.1}"
SERVER_PORT="${SERVER_PORT:-8080}"
SERVER_PARALLEL="${SERVER_PARALLEL:-8}"
SERVER_CTX_SIZE="${SERVER_CTX_SIZE:-32768}"
SERVER_BATCH_SIZE="${SERVER_BATCH_SIZE:-2048}"
SERVER_UBATCH_SIZE="${SERVER_UBATCH_SIZE:-512}"
GPU_LAYERS="${GPU_LAYERS:-99}"
FLASH_ATTN="${FLASH_ATTN:-auto}"

# Minimal serving matrix: 1 and 8 concurrent clients. Sixteen requests gives
# two waves at concurrency 8 while keeping the starter experiment quick.
CONCURRENCY_LEVELS="${CONCURRENCY_LEVELS:-1 8}"
REQUESTS_PER_LEVEL="${REQUESTS_PER_LEVEL:-16}"
REPETITIONS="${REPETITIONS:-3}"
TARGET_PROMPT_TOKENS="${TARGET_PROMPT_TOKENS:-2048}"
MAX_OUTPUT_TOKENS="${MAX_OUTPUT_TOKENS:-128}"
WARMUP_REQUESTS="${WARMUP_REQUESTS:-1}"
REQUEST_TIMEOUT_SECONDS="${REQUEST_TIMEOUT_SECONDS:-600}"
RANDOM_SEED="${RANDOM_SEED:-20260909}"
