# Same request workload, explicitly split across two GPUs.
GPU_DEVICE="${GPU_DEVICE:-0,1}"
source "$(dirname "${BASH_SOURCE[0]}")/remote-study.env"
EXPERIMENT_NAME="llama-70b-multigpu-serving"
SERVER_SPLIT_MODE="layer"
SERVER_TENSOR_SPLIT="1,1"
SERVER_MAIN_GPU="0"
SERVER_STARTUP_TIMEOUT_SECONDS="600"
# Stream weights through small buffers: this host reserves 84 GiB for huge pages.
SERVER_LOAD_MODE="none"
