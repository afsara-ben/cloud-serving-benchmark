ACCELERATOR_BACKEND="${ACCELERATOR_BACKEND:-cuda}"
REQUEST_TIMEOUT_SECONDS="${REQUEST_TIMEOUT_SECONDS:-7200}"
source "$(dirname "${BASH_SOURCE[0]}")/experiment.env"
