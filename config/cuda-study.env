# Fixed CUDA study; MODEL_* values are supplied by scripts/08_run_cuda_study.py.
source "$(dirname "${BASH_SOURCE[0]}")/experiment.env"
EXPERIMENT_NAME="datacenter-gpus-quantization-perspective"
ACCELERATOR_BACKEND="cuda"
LLAMA_CPP_REF="3f5e94d7c2ab2267fe39852051777fe30c1f49ef"
GPU_DEVICE="0"
SERVER_HOST="127.0.0.1"
SERVER_PORT="8080"
SERVER_PARALLEL="8"
SERVER_CTX_SIZE="32768"
SERVER_BATCH_SIZE="2048"
SERVER_UBATCH_SIZE="512"
GPU_LAYERS="99"
FLASH_ATTN="on"
# Pinned llama.cpp defaults: K=f16 and V=f16; no KV quantization.
CONCURRENCY_LEVELS="1 8"
REQUESTS_PER_LEVEL="16"
REPETITIONS="3"
TARGET_PROMPT_TOKENS="2048"
MAX_OUTPUT_TOKENS="128"
WARMUP_REQUESTS="0"
REQUEST_TIMEOUT_SECONDS="600"
RANDOM_SEED="20260912"
